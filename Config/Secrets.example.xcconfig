// Copy to Config/Secrets.xcconfig. Secrets.xcconfig is gitignored. Never commit it.

// Option A (development): key built into the app.
GEMINI_API_KEY = paste-your-key-here

// Option B (anything you share): key stays on your proxy (server/gemini-proxy.js).
// Leave GEMINI_API_KEY empty and set:
// GEMINI_PROXY_HOST = sightsense-proxy.your-account.workers.dev
// GEMINI_APP_TOKEN = the-same-random-token-you-gave-the-proxy

// Optional: pin a model for any job instead of the "latest" aliases, e.g.
// GEMINI_MODEL_SMART = gemini-3.8-flash
